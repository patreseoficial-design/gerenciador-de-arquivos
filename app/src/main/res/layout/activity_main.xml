<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- CABEÇALHO PRINCIPAL -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#242424">

        <!-- MENU ESQUERDO -->
        <TextView
            android:id="@+id/menuLeft"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center"
            android:translationY="5dp"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- TÍTULO CENTRALIZADO -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:translationY="8dp"
            android:text="Gerenciador de Arquivos"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false"/>

        <!-- MENU DIREITO -->
        <TextView
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:translationY="5dp"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true"/>

    </FrameLayout>

    <!-- HOME -->
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- PESQUISA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#777777"
                    android:textSize="30sp"/>

                <EditText
                    android:id="@+id/searchEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Pesquisar arquivos"
                    android:singleLine="true"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="15sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp"/>

            <!-- ARMAZENAMENTO PRINCIPAL -->
            <LinearLayout
                android:id="@+id/categoryStorage"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:src="@drawable/armazenamento"
                    android:scaleType="fitXY"
                    android:contentDescription="Armazenamento principal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Armazenamento principal"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/storageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Calculando..."
                        android:textColor="#777777"
                        android:textSize="13sp"/>

                    <ProgressBar
                        android:id="@+id/storageProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="7dp"
                        android:max="100"
                        android:progress="0"/>

                </LinearLayout>

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp"/>

            <!-- LINHA 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- DOWNLOADS -->
                <LinearLayout
                    android:id="@+id/categoryDownloads"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/downloads"
                        android:scaleType="fitCenter"
                        android:contentDescription="Downloads"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Downloads"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- ANÁLISE -->
                <LinearLayout
                    android:id="@+id/categoryAnalysis"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/armazenamento"
                        android:scaleType="fitCenter"
                        android:contentDescription="Análise do armazenamento"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Análise"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- IMAGENS -->
                <LinearLayout
                    android:id="@+id/categoryImages"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/imagens"
                        android:scaleType="fitCenter"
                        android:contentDescription="Imagens"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Imagens"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- LINHA 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- ÁUDIO -->
                <LinearLayout
                    android:id="@+id/categoryAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- ÍCONE EXISTENTE: FONE DE OUVIDO -->
                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/audios"
                        android:scaleType="fitCenter"
                        android:contentDescription="Áudio"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Áudio"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- VÍDEOS -->
                <LinearLayout
                    android:id="@+id/categoryVideos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/videos"
                        android:scaleType="fitCenter"
                        android:contentDescription="Vídeos"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vídeos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- DOCUMENTOS -->
                <LinearLayout
                    android:id="@+id/categoryDocuments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/documentos"
                        android:scaleType="fitCenter"
                        android:contentDescription="Documentos"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documentos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- LINHA 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- APLICATIVOS -->
                <LinearLayout
                    android:id="@+id/categoryApps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/aplicativos"
                        android:scaleType="fitCenter"
                        android:contentDescription="Aplicativos"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aplicativos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- LIXEIRA -->
                <LinearLayout
                    android:id="@+id/categoryTrash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/lixeira"
                        android:scaleType="fitCenter"
                        android:contentDescription="Lixeira"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lixeira"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- CARTÃO DE MEMÓRIA -->
                <LinearLayout
                    android:id="@+id/categoryMemoryCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="80dp"
                        android:src="@drawable/cartao_memoria"
                        android:scaleType="fitCenter"
                        android:contentDescription="Cartão de memória"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SD card"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- TELA DE ARQUIVOS -->
    <LinearLayout
        android:id="@+id/fileScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- CABEÇALHO DA SEGUNDA TELA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <!-- VOLTAR -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#222222"
                android:textSize="42sp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/fileScreenTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="Arquivos"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- CAMINHO -->
        <TextView
            android:id="@+id/currentPath"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#555555"
            android:textSize="14sp"
            android:background="#F5F5F5"/>

        <!-- ABAS DOS APLICATIVOS -->
        <LinearLayout
            android:id="@+id/appTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/tabAppsNativos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nativos"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabAppsBaixados"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Baixados"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- LISTA NORMAL -->
        <ListView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:dividerHeight="1dp"
            android:background="#FFFFFF"/>

        <!-- GRADE DE IMAGENS/VÍDEOS -->
        <GridView
            android:id="@+id/mediaGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="3"
            android:columnWidth="110dp"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="4dp"
            android:stretchMode="columnWidth"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
