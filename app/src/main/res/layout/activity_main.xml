<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#242424">

        <TextView
            android:id="@+id/menuLeft"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Gerenciador de Arquivos"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- TELA PRINCIPAL -->
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">


            <!-- PESQUISA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#777777"
                    android:textSize="30sp"/>

                <EditText
                    android:id="@+id/searchEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Pesquisar arquivos"
                    android:singleLine="true"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="15sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>

            </LinearLayout>


            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp"/>


            <!-- ARMAZENAMENTO PRINCIPAL -->
            <LinearLayout
                android:id="@+id/categoryStorage"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:gravity="center"
                    android:text="▰"
                    android:textColor="#777777"
                    android:textSize="48sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Armazenamento principal"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/storageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Calculando..."
                        android:textColor="#777777"
                        android:textSize="13sp"/>

                    <ProgressBar
                        android:id="@+id/storageProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="7dp"
                        android:max="100"
                        android:progress="0"/>

                </LinearLayout>

            </LinearLayout>


            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp"/>


            <!-- GRADE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- DOWNLOADS -->
                <LinearLayout
                    android:id="@+id/categoryDownloads"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="↓"
                        android:textColor="#D99A3A"
                        android:textSize="48sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Downloads"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- ANÁLISE -->
                <LinearLayout
                    android:id="@+id/categoryAnalysis"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="◕"
                        android:textColor="#666666"
                        android:textSize="52sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Análise"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- IMAGENS -->
                <LinearLayout
                    android:id="@+id/categoryImages"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="▱"
                        android:textColor="#7131A8"
                        android:textSize="50sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Imagens"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- ÁUDIO -->
                <LinearLayout
                    android:id="@+id/categoryAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textColor="#008F83"
                        android:textSize="50sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Áudio"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- VÍDEOS -->
                <LinearLayout
                    android:id="@+id/categoryVideos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="▣"
                        android:textColor="#C52E32"
                        android:textSize="48sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vídeos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- DOCUMENTOS -->
                <LinearLayout
                    android:id="@+id/categoryDocuments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="☰"
                        android:textColor="#1976C9"
                        android:textSize="45sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documentos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <!-- APLICATIVOS -->
                <LinearLayout
                    android:id="@+id/categoryApps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#91C82E"
                        android:textSize="48sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aplicativos"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- LIXEIRA -->
                <LinearLayout
                    android:id="@+id/categoryTrash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:gravity="center"
                        android:text="♜"
                        android:textColor="#777777"
                        android:textSize="46sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lixeira"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- ESPAÇO -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- TELA DE ARQUIVOS -->

    <LinearLayout
        android:id="@+id/fileScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#222222"
                android:textSize="38sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/fileScreenTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Arquivos"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/currentPath"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingStart="16dp"
            android:gravity="center_vertical"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#777777"
            android:textSize="12sp"/>

        <ListView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:dividerHeight="1dp"
            android:background="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>
