<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Acesso completo ao armazenamento -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 10 e anteriores: permissão comum de arquivos -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        Em vez de QUERY_ALL_PACKAGES (barrada pela Play Store),
        o app declara só o que precisa ver: apps com ícone na tela
        inicial e apps que abrem/compartilham arquivos.
    -->
    <queries>

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>

        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>

    </queries>

    <!-- Transferência pelo Wi-Fi, anúncios e compras -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Aviso de celular quase cheio (Android 13+) -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permite pedir a desinstalação de aplicativos -->
    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".FaxinaApp"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- VISUALIZADOR DE PDF -->
        <activity
            android:name=".PdfViewerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- VISUALIZADOR DE IMAGENS -->
        <activity
            android:name=".ImageViewerActivity"
            android:screenOrientation="fullUser"
            android:exported="false" />

        <!-- VISUALIZADOR / EXTRATOR DE ZIP -->
        <activity
            android:name=".ZipViewerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- VISUALIZADOR DE VÍDEOS -->
        <activity
            android:name=".VideoViewerActivity"
            android:screenOrientation="fullUser"
            android:exported="false" />

        <!-- REPRODUTOR INTERNO DE ÁUDIO -->
        <activity
            android:name=".AudioViewerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- TELA PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- ID do app no AdMob (vem do build.gradle.kts) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- FERRAMENTAS: WhatsApp, duplicadas, cofre e Premium -->
        <activity
            android:name=".LimpezaWhatsAppActivity"
            android:exported="false" />

        <activity
            android:name=".DuplicadasActivity"
            android:exported="false" />

        <activity
            android:name=".CofreActivity"
            android:exported="false" />

        <activity
            android:name=".PremiumActivity"
            android:exported="false" />

        <activity
            android:name=".CompressaoActivity"
            android:exported="false" />

        <activity
            android:name=".TransferenciaWifiActivity"
            android:exported="false" />

        <!-- WIDGET: ESPAÇO LIVRE -->
        <receiver
            android:name=".WidgetEspaco"
            android:exported="false">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_espaco_info" />

        </receiver>

        <!-- FILE PROVIDER -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>
